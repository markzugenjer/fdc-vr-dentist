{
  "name": "fdc-vr-dentist",
  "version": "0.1.0",
  "private": true,
  "description": "FDC Dentist: a cartoon dental clinic game for Meta Quest 3. Three.js + WebXR.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "quest:connect": "adb reverse tcp:5175 tcp:5175",
    "apk:setup": "node scripts/apk.mjs setup",
    "apk:build": "node scripts/apk.mjs build",
    "pages:setup": "node -e \"require('fs').mkdirSync('.github/workflows',{recursive:true});require('fs').copyFileSync('scripts/deploy-pages.yml','.github/workflows/deploy.yml');console.log('Created .github/workflows/deploy.yml')\"",
    "voices:list": "node scripts/voices.mjs --list",
    "voices": "node scripts/voices.mjs"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4",
    "three": "0.160.0"
  },
  "devDependencies": {
    "vite": "5.4.10"
  }
}
